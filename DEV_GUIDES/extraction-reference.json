{
  "_description": "Reference for all document extraction flows. Shows every key-value pair extracted per document type, the pipeline steps, and where each piece lives in the codebase.",

  "pipeline_flow": {
    "step_1_ui_upload": {
      "file": "app/(app)/documents/upload/page.tsx",
      "description": "User selects a document type card and picks a file (PDF or image, max 20MB). FormData with 'file' + 'documentType' string is POSTed to /api/documents/upload."
    },
    "step_2_upload_api": {
      "file": "app/api/documents/upload/route.ts",
      "description": "Validates JWT auth, file size, MIME type, and that documentType is in SUPPORTED_DOCUMENT_TYPES. Calls extractDocument(docType, file, filename)."
    },
    "step_3_openai_extraction": {
      "file": "extraction/openai.ts",
      "description": "Uploads file to OpenAI Files API (purpose: user_data), then calls client.responses.create() with the file, document-specific prompt, and JSON schema (strict: true). Model: gpt-4o-mini by default. Returns structured JSON.",
      "sub_steps": {
        "a_get_config": "getDocumentPromptConfig(docType) returns { prompt, schema (Zod), jsonSchema } from extraction/prompts/index.ts registry.",
        "b_upload_file": "uploadFile() sends the file to OpenAI Files API, gets back a file_id.",
        "c_call_model": "responses.create() with input: [{ input_file: file_id }, { input_text: prompt }], text.format: { type: 'json_schema', schema: jsonSchema, strict: true }.",
        "d_parse_validate": "JSON.parse the output_text, then config.schema.safeParse() to validate against the Zod schema."
      }
    },
    "step_4_build_stored_doc": {
      "file": "app/api/documents/upload/route.ts",
      "description": "Builds a StoredDocument object with { userId, documentType, data: extractedResult, originalFilename, createdAt }. The 'data' field is the full extraction."
    },
    "step_5_mongodb_insert": {
      "file": "lib/mongodb.ts",
      "description": "Inserts into the 'documents' collection in the 'tax' database. Indexes: { userId: 1 } and { userId: 1, documentType: 1 }."
    },
    "step_6_response": {
      "description": "Returns { document: { id, documentType, originalFilename, createdAt } }. Note: the extracted 'data' is NOT returned to the client; it is only stored."
    }
  },

  "registry": {
    "file": "extraction/prompts/index.ts",
    "supported_types": ["passport", "i20", "w2"],
    "how_it_works": "Each type has { prompt, schema (Zod), jsonSchema (OpenAI structured output) }. getDocumentPromptConfig(type) looks it up. isSupportedDocumentType(type) checks membership."
  },

  "stored_document_shape": {
    "file": "lib/types/document.ts",
    "common_fields": {
      "_id": "ObjectId (auto-generated by MongoDB)",
      "userId": "ObjectId (from JWT payload.sub)",
      "documentType": "string literal matching the type key",
      "data": "The full extraction result (type-specific, see below)",
      "originalFilename": "string (optional, the uploaded file name)",
      "createdAt": "Date"
    }
  },

  "document_types": {
    "passport": {
      "extraction_file": "extraction/prompts/documents/passport.ts",
      "type_name": "PassportExtraction",
      "stored_type_name": "StoredDocumentPassport",
      "extracted_fields": {
        "document_type": { "type": "string", "description": "Document type code, e.g. 'P'", "required": true },
        "issuing_country": { "type": "string", "description": "Issuing country name or code", "required": true },
        "passport_type": { "type": "string", "description": "Passport type", "required": true },
        "country_code": { "type": "string", "description": "Country code (e.g. IND, USA)", "required": true },
        "passport_number": { "type": "string", "description": "Passport number", "required": true },
        "surname": { "type": "string", "description": "Surname / family name", "required": true },
        "given_names": { "type": "string", "description": "Given names", "required": true },
        "nationality": { "type": "string", "description": "Nationality", "required": true },
        "sex": { "type": "string", "description": "Sex / gender", "required": true },
        "date_of_birth": { "type": "string", "description": "YYYY-MM-DD", "required": true },
        "place_of_birth": { "type": "string", "description": "Place of birth", "required": true },
        "place_of_issue": { "type": "string", "description": "Place of issue", "required": true },
        "date_of_issue": { "type": "string", "description": "YYYY-MM-DD", "required": true },
        "date_of_expiry": { "type": "string", "description": "YYYY-MM-DD", "required": true },
        "photo": {
          "type": "object",
          "required": true,
          "fields": {
            "present": { "type": "boolean", "description": "Whether a photo is visible on the document" },
            "image_ref": { "type": "string", "description": "Always '' (images not extracted)" }
          }
        },
        "signature": {
          "type": "object",
          "required": true,
          "fields": {
            "present": { "type": "boolean", "description": "Whether a signature is visible" },
            "image_ref": { "type": "string", "description": "Always '' (images not extracted)" }
          }
        },
        "mrz": {
          "type": "object",
          "required": false,
          "description": "Machine-Readable Zone (bottom of passport)",
          "fields": {
            "line1": { "type": "string", "description": "Raw MRZ line 1" },
            "line2": { "type": "string", "description": "Raw MRZ line 2" },
            "parsed": {
              "type": "object",
              "fields": {
                "document_code": "string",
                "issuing_state": "string",
                "primary_identifier": "string",
                "secondary_identifiers": "string",
                "passport_number": "string",
                "nationality": "string",
                "date_of_birth": "string",
                "sex": "string",
                "date_of_expiry": "string",
                "personal_number": "string",
                "check_digits": {
                  "type": "object",
                  "fields": {
                    "passport_number": "string",
                    "date_of_birth": "string",
                    "date_of_expiry": "string",
                    "personal_number": "string",
                    "composite": "string"
                  }
                }
              }
            }
          }
        },
        "parents": {
          "type": "object",
          "required": false,
          "fields": {
            "father_or_legal_guardian_name": "string",
            "mother_name": "string"
          }
        },
        "spouse": {
          "type": "object",
          "required": false,
          "fields": {
            "name": "string"
          }
        },
        "address": {
          "type": "object",
          "required": false,
          "fields": {
            "address_line1": "string",
            "address_line2": "string",
            "city_or_district": "string",
            "state": "string",
            "postal_code": "string",
            "country": "string"
          }
        },
        "old_passport": {
          "type": "object",
          "required": false,
          "fields": {
            "passport_number": "string",
            "date_of_issue": "string",
            "place_of_issue": "string"
          }
        },
        "file_number": { "type": "string", "required": false, "description": "File number if present" },
        "raw_fields": {
          "type": "object",
          "required": false,
          "description": "NOT sent to OpenAI (not in jsonSchema). Only in Zod schema for optional local use.",
          "fields": {
            "all_visible_text_blocks": "string[]",
            "page_map": "Record<string, string[]>"
          }
        },
        "source": {
          "type": "object",
          "required": false,
          "fields": {
            "file_name": "string",
            "pages_included": "number[]"
          }
        }
      }
    },

    "i20": {
      "extraction_file": "extraction/prompts/documents/i20.ts",
      "type_name": "I20Extraction",
      "stored_type_name": "StoredDocumentI20",
      "extracted_fields": {
        "sevis_id": { "type": "string", "description": "SEVIS identification number", "required": true },
        "class_of_admission": { "type": "string", "description": "Class of admission code (e.g. F-1)", "required": true },
        "student": {
          "type": "object",
          "required": true,
          "fields": {
            "surname_primary_name": { "type": "string", "description": "Family name / surname" },
            "given_name": { "type": "string", "description": "Given name" },
            "preferred_name": { "type": "string", "description": "Preferred name if any" },
            "passport_name": { "type": "string", "description": "Name as on passport" },
            "country_of_birth": { "type": "string", "description": "Country of birth" },
            "city_of_birth": { "type": "string", "description": "City of birth" },
            "country_of_citizenship": { "type": "string", "description": "Country of citizenship" },
            "date_of_birth": { "type": "string", "description": "YYYY-MM-DD" },
            "admission_number": { "type": "string", "description": "Admission number / I-94 number" },
            "form_issue_reason": { "type": "string", "description": "Reason form was issued" }
          }
        },
        "school_information": {
          "type": "object",
          "required": true,
          "fields": {
            "school_name": { "type": "string", "description": "Name of school" },
            "school_address": { "type": "string", "description": "Full school address" },
            "school_official_contact": {
              "type": "object",
              "fields": {
                "name": { "type": "string", "description": "DSO or official name" },
                "title": { "type": "string", "description": "Title" }
              }
            },
            "school_code": { "type": "string", "description": "School code" },
            "school_approval_date": { "type": "string", "description": "School approval date" }
          }
        },
        "program_of_study": {
          "type": "object",
          "required": true,
          "fields": {
            "education_level": { "type": "string", "description": "Level of education (e.g. Master's)" },
            "major_1": {
              "type": "object",
              "fields": {
                "name": { "type": "string", "description": "Primary major name" },
                "cip_code": { "type": "string", "description": "CIP code" }
              }
            },
            "major_2": {
              "type": "object",
              "fields": {
                "name": { "type": "string", "description": "Secondary major name if any" },
                "cip_code": { "type": "string", "description": "CIP code" }
              }
            },
            "program_english_proficiency": { "type": "string", "description": "English proficiency for program" },
            "english_proficiency_notes": { "type": "string", "description": "Notes on English proficiency" },
            "earliest_admission_date": { "type": "string", "description": "YYYY-MM-DD" },
            "start_of_classes": { "type": "string", "description": "YYYY-MM-DD" },
            "program_start_date": { "type": "string", "description": "YYYY-MM-DD" },
            "program_end_date": { "type": "string", "description": "YYYY-MM-DD" }
          }
        },
        "financials": {
          "type": "object",
          "required": true,
          "fields": {
            "period_months": { "type": "number", "description": "Period in months (e.g. 12)" },
            "estimated_average_costs": {
              "type": "object",
              "fields": {
                "tuition_and_fees": { "type": "string", "description": "Dollar amount" },
                "living_expenses": { "type": "string", "description": "Dollar amount" },
                "expenses_of_dependents": {
                  "type": "object",
                  "fields": {
                    "count": { "type": "number", "description": "Number of dependents" },
                    "amount": { "type": "string", "description": "Dollar amount" }
                  }
                },
                "health_insurance_books_supplies": { "type": "string", "description": "Dollar amount" },
                "total": { "type": "string", "description": "Total estimated costs" }
              }
            },
            "students_funding": {
              "type": "object",
              "fields": {
                "personal_funds": { "type": "string", "description": "Dollar amount" },
                "funds_from_this_school": { "type": "string", "description": "Dollar amount" },
                "family_funds": { "type": "string", "description": "Dollar amount" },
                "on_campus_employment": { "type": "string", "description": "Dollar amount" },
                "total": { "type": "string", "description": "Total funding" }
              }
            }
          }
        },
        "remarks": { "type": "string", "description": "Remarks if any", "required": true },
        "school_attestation": {
          "type": "object",
          "required": true,
          "fields": {
            "dso_signature_present": { "type": "boolean", "description": "Whether DSO signature is visible" },
            "signature_of_name": { "type": "string", "description": "Signatory name" },
            "signature_of_title": { "type": "string", "description": "Signatory title" },
            "date_issued": { "type": "string", "description": "YYYY-MM-DD" },
            "place_issued": { "type": "string", "description": "Place issued" }
          }
        },
        "student_attestation": {
          "type": "object",
          "required": true,
          "fields": {
            "student_signature_present": { "type": "boolean", "description": "Whether student signature is visible" },
            "signature_of_name": { "type": "string", "description": "Student name" },
            "date": { "type": "string", "description": "YYYY-MM-DD" },
            "parent_or_guardian": {
              "type": "object",
              "fields": {
                "name": { "type": "string", "description": "Parent or guardian name" },
                "signature_present": { "type": "boolean", "description": "Whether parent/guardian signature is visible" },
                "address": { "type": "string", "description": "Address" },
                "date": { "type": "string", "description": "YYYY-MM-DD" }
              }
            }
          }
        },
        "page_2": {
          "type": "object",
          "required": true,
          "fields": {
            "employment_authorizations": { "type": "string", "description": "Employment authorizations if any" },
            "change_of_status_cap_gap_extension": { "type": "string", "description": "Change of status / CAP-GAP extension" },
            "authorized_reduced_course_load": { "type": "string", "description": "Authorized reduced course load" },
            "current_session_dates": {
              "type": "object",
              "fields": {
                "start_date": { "type": "string", "description": "YYYY-MM-DD" },
                "end_date": { "type": "string", "description": "YYYY-MM-DD" }
              }
            },
            "travel_endorsements": {
              "type": "array",
              "description": "Array of travel endorsement objects",
              "item_fields": {
                "designated_school_official": { "type": "string", "description": "DSO name" },
                "title": { "type": "string", "description": "Title" },
                "signature_present": { "type": "boolean", "description": "Signature is visible" },
                "date_issued": { "type": "string", "description": "YYYY-MM-DD" },
                "place_issued": { "type": "string", "description": "Place issued" }
              }
            }
          }
        },
        "form_meta": {
          "type": "object",
          "required": true,
          "fields": {
            "form_name": { "type": "string", "description": "Form name (I-20, Certificate of Eligibility...)" },
            "omb_number": { "type": "string", "description": "OMB number (1653-0038)" },
            "edition_date": { "type": "string", "description": "Edition date" }
          }
        }
      }
    },

    "w2": {
      "extraction_file": "extraction/prompts/forms/w2.ts",
      "type_name": "W2Extraction",
      "stored_type_name": "StoredDocumentW2",
      "extracted_fields": {
        "employerName": { "type": "string", "description": "Employer's name", "required": true },
        "employerEin": { "type": "string", "description": "Employer's EIN", "required": false },
        "employerAddress": { "type": "string", "description": "Employer's address", "required": false },
        "employeeSsn": { "type": "string", "description": "Employee's SSN", "required": false },
        "employeeName": { "type": "string", "description": "Employee's name", "required": true },
        "employeeAddress": { "type": "string", "description": "Employee's address", "required": false },
        "wagesTipsOther": { "type": "number", "description": "Wages, tips, other compensation (Box 1)", "required": false },
        "federalIncomeTaxWithheld": { "type": "number", "description": "Federal income tax withheld (Box 2)", "required": false },
        "socialSecurityWages": { "type": "number", "description": "Social security wages (Box 3)", "required": false },
        "socialSecurityTaxWithheld": { "type": "number", "description": "Social security tax withheld (Box 4)", "required": false },
        "medicareWagesAndTips": { "type": "number", "description": "Medicare wages and tips (Box 5)", "required": false },
        "medicareTaxWithheld": { "type": "number", "description": "Medicare tax withheld (Box 6)", "required": false },
        "socialSecurityTips": { "type": "number", "description": "Social security tips (Box 7)", "required": false },
        "allocatedTips": { "type": "number", "description": "Allocated tips (Box 8)", "required": false },
        "dependentCareBenefits": { "type": "number", "description": "Dependent care benefits (Box 10)", "required": false },
        "nonqualifiedPlans": { "type": "number", "description": "Nonqualified plans (Box 11)", "required": false },
        "taxYear": { "type": "string", "description": "Tax year (e.g. 2024)", "required": false }
      }
    }
  },

  "files_to_touch_for_new_type": [
    { "step": 1, "file": "extraction/prompts/documents/<new-doc>.ts  OR  extraction/prompts/forms/<new-form>.ts", "what": "Create Zod schema, export type, prompt string, and JSON schema object" },
    { "step": 2, "file": "extraction/prompts/index.ts", "what": "Import schema/prompt/jsonSchema, add to registry object, add to SUPPORTED_DOCUMENT_TYPES array, export the type" },
    { "step": 3, "file": "lib/types/document.ts", "what": "Import extraction type, define StoredDocumentXxx, add to StoredDocument union" },
    { "step": 4, "file": "app/api/documents/upload/route.ts", "what": "Import types, add branch in storedDoc ternary" },
    { "step": 5, "file": "app/(app)/documents/upload/page.tsx", "what": "Add entry to DOCUMENT_TYPES array so user can select it" }
  ]
}
